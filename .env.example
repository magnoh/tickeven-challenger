# =============================================================================
# TickEven - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env com dados reais no repositório!
# =============================================================================

# Banco de Dados (Supabase em produção, ou Postgres local)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# Segurança do Backend (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="sua_chave_jwt_super_secreta_aqui"

# APIs Externas (The Movie Database - TMDB)
TMDB_BEARER_TOKEN="seu_bearer_token_tmdb_aqui"
TMDB_API_KEY="sua_chave_api_v3_tmdb_aqui"

# Backend
FRONTEND_URL="http://localhost:5173"
PORT=3000

# Frontend (URL da API consumida pelo React/Vite)
VITE_API_URL="http://localhost:3000"
