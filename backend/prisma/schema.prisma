generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum ReservationStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       Event[]
  reservations Reservation[]
  tickets      Ticket[]
}

model Event {
  id               String      @id @default(cuid())
  externalId       String?
  title            String
  description      String
  imageUrl         String?
  date             DateTime
  location         String
  capacity         Int
  availableTickets Int
  price            Decimal     @db.Decimal(10, 2)
  status           EventStatus @default(DRAFT)
  organizerId      String
  organizer        User        @relation(fields: [organizerId], references: [id])
  reservations     Reservation[]
  tickets          Ticket[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([organizerId])
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String
  eventId   String
  quantity  Int
  total     Decimal           @db.Decimal(10, 2)
  status    ReservationStatus @default(PENDING)
  expiresAt DateTime
  user      User              @relation(fields: [userId], references: [id])
  event     Event             @relation(fields: [eventId], references: [id])
  tickets   Ticket[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String
  eventId       String
  userId        String
  codeHash      String       @unique
  status        TicketStatus @default(ACTIVE)
  usedAt        DateTime?
  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  event         Event        @relation(fields: [eventId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([eventId])
  @@index([status])
}
